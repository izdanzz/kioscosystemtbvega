# Claves de conexión con Supabase (Obtenlas en tu proyecto en https://supabase.com -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key-aqui

# Puerto de la app
PORT=3000

# URL del agente local de impresión
NEXT_PUBLIC_PRINT_SERVER_URL=http://localhost:5000
